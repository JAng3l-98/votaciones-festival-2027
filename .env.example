# Copia este archivo como .env y pon tus propios valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Clave secreta de Django: genera una con
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=pega-aqui-la-clave-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión a MySQL (base y usuario creados según el README)
DB_ENGINE=mysql
DB_NAME=votaciones_festival
DB_USER=festival
DB_PASSWORD=pon-aqui-la-clave-de-mysql
DB_HOST=localhost
DB_PORT=3306

# ---- Correo (recuperar la contraseña) ----
# En el equipo local los correos se muestran en la terminal de runserver; no hace falta nada.
# Para enviarlos de verdad, quita los # y completa con los datos de tu servidor SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.ejemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario-del-correo
# EMAIL_HOST_PASSWORD=pon-aqui-la-clave-del-correo
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Votaciones del Festival <no-responder@ejemplo.com>

# ---- Publicación en internet (solo en el servidor, nunca en el equipo local) ----
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=votaciones.ejemplo.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://votaciones.ejemplo.org
# DJANGO_HTTPS=1
# DJANGO_HSTS_SECONDS=3600
