# Copia este archivo como .env y pon tus propios valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Clave secreta de Django: genera una con
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=pega-aqui-la-clave-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión a MySQL (base y usuario creados según el README)
DB_ENGINE=mysql
DB_NAME=votaciones_festival
DB_USER=festival
DB_PASSWORD=pon-aqui-la-clave-de-mysql
DB_HOST=localhost
DB_PORT=3306
